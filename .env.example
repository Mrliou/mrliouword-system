# Mrliouword Agent SDK 環境變數範例
# 複製此檔案為 .env 並填入實際值
# Origin Signature: MrLiouWord
#
# 詳細說明請參考 docs/MIGRATION.md

# ──────────────────────────────────────────────
# Phase 0-1：過渡期 Firebase 啟動
# NEXT_PUBLIC_* 可出現在瀏覽器端（不要放機密）
# ──────────────────────────────────────────────

NEXT_PUBLIC_AUTH_PROVIDER=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Phase 2+：自主化目標變數
# 切換驗證為 Authentik 後，移除上方 FIREBASE 變數
# ──────────────────────────────────────────────

# NEXT_PUBLIC_AUTH_PROVIDER=authentik
NEXT_PUBLIC_AUTH_BASE_URL=https://auth.mrliouword.com
NEXT_PUBLIC_AUTH_CLIENT_ID=mrliouai-control-center
NEXT_PUBLIC_API_BASE_URL=https://api.mrliouword.com
NEXT_PUBLIC_APP_NAME=MRLiouAI
NEXT_PUBLIC_ORIGIN_SIGNATURE=MrLiouWord

# ──────────────────────────────────────────────
# Provider 切換旗標（server 端讀取）
# ──────────────────────────────────────────────

# Phase 0-1: firestore  / Phase 2+: postgres
UI_STATE_PROVIDER=firestore
# Phase 0-1: kv         / Phase 2+: api (via gateway → pgvector)
MEMORY_PROVIDER=api
# local | gemini | openai | anthropic
AI_PROVIDER=local
# minio | r2
STORAGE_PROVIDER=minio

# ──────────────────────────────────────────────
# SERVER 端機密 — 絕不可加 NEXT_PUBLIC_ 前綴
# ──────────────────────────────────────────────

# Authentik OAuth2 (Phase 2+)
AUTH_ISSUER=https://auth.mrliouword.com/application/o/mrliouai/
AUTH_CLIENT_ID=mrliouai-control-center
AUTH_CLIENT_SECRET=replace-with-actual-secret

# MRL 本地 AI Runtime（DL580）
MRL_API_BASE_URL=http://localhost:7810

# PostgreSQL
POSTGRES_USER=mrl_user
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=mrliouai
DATABASE_URL=******localhost:5432/mrliouai

# Redis
REDIS_URL=redis://localhost:6379

# MinIO（僅 server 端）
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=mrliouai
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key

# Authentik 內部機密金鑰
AUTHENTIK_SECRET_KEY=replace-with-long-random-string

# ──────────────────────────────────────────────
# Python Agent SDK（既有設定）
# ──────────────────────────────────────────────

ANTHROPIC_API_KEY=your-api-key-here
MODEL=claude-sonnet-4-20250514
MAX_TOKENS=4096

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/mrliouword.log

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

ENABLE_AUTH=false
API_KEY=
RATE_LIMIT=100

ENABLE_METRICS=true
ENABLE_TRACING=false
SENTRY_DSN=

TRACK_COSTS=true
COST_ALERT_THRESHOLD=100.0

