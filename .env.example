# Mrliouword Agent SDK 環境變數範例
# 複製此檔案為 .env 並填入實際值

# Anthropic API
ANTHROPIC_API_KEY=your-api-key-here
MODEL=claude-sonnet-4-20250514
MAX_TOKENS=4096

# 環境設定
ENVIRONMENT=development
DEBUG=false

# 日誌設定
LOG_LEVEL=INFO
LOG_FILE=logs/mrliouword.log

# API 設定
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# 安全設定
ENABLE_AUTH=false
API_KEY=
RATE_LIMIT=100

# 監控設定
ENABLE_METRICS=true
ENABLE_TRACING=false
SENTRY_DSN=

# 成本追蹤
TRACK_COSTS=true
COST_ALERT_THRESHOLD=100.0
