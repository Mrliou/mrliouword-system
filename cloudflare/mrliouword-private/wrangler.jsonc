{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mrliouword-private",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "kv_namespaces": [
    {
      "binding": "MRLIOUWORD_VAULT",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MRLIOUBOOK",
      "bucket_name": "mrlioubook"
    }
  ],
  "vars": {
    "ORIGIN": "MrLiouWord",
    "VERSION": "2.0.0"
  }
}
